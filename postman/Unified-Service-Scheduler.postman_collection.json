{
  "info": {
    "_postman_id": "8ba6792f-bf11-4e16-a387-482b3d256031",
    "name": "Unified Service Scheduler - Scenario A",
    "description": "Scenario A REST API walkthrough. Set baseUrl if the API is not at http://localhost:8080, then run requests in order. The booking request chooses a future time and saves its appointment ID for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "startAt",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "conflictKey",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Reference data",
      "item": [
        {
          "name": "List service types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/service-types"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns service types', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List dealership resources",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dealerships/dealer-1/resources"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns dealership resources', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().dealershipId).to.eql('dealer-1');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Appointment booking",
      "item": [
        {
          "name": "Create appointment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const startAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);",
                  "startAt.setUTCMinutes(Math.floor(Math.random() * 60), 0, 0);",
                  "pm.collectionVariables.set('startAt', startAt.toISOString());",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates appointment and returns Location', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.headers.has('Location')).to.be.true;",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('appointmentId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealershipId\": \"dealer-1\",\n  \"customerId\": \"customer-1\",\n  \"vehicleId\": \"vehicle-1\",\n  \"serviceTypeId\": \"oil-change\",\n  \"startAt\": \"{{startAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/appointments"
          }
        },
        {
          "name": "Retry same booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Replays the original appointment', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('appointmentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealershipId\": \"dealer-1\",\n  \"customerId\": \"customer-1\",\n  \"vehicleId\": \"vehicle-1\",\n  \"serviceTypeId\": \"oil-change\",\n  \"startAt\": \"{{startAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/appointments"
          }
        },
        {
          "name": "Try overlapping booking with a new key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('conflictKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects overlapping vehicle booking', function () {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().code).to.eql('VEHICLE_ALREADY_BOOKED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{conflictKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealershipId\": \"dealer-1\",\n  \"customerId\": \"customer-1\",\n  \"vehicleId\": \"vehicle-1\",\n  \"serviceTypeId\": \"oil-change\",\n  \"startAt\": \"{{startAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/appointments"
          }
        },
        {
          "name": "Get created appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reads the created appointment', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('appointmentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "List appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns paginated appointments', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.property('content').that.is.an('array');",
                  "    pm.expect(pm.response.json()).to.have.property('totalElements');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/appointments?page=0&size=20"
          }
        }
      ]
    }
  ]
}
